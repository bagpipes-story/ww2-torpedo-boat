+++ b/src/config/title-layout-config.ts
@@ -1,7 +1,7 @@
 // Title の任務の行の置き方（論理 px。高さ 720・幅 1280〜1584）。v0.6.7 で menu-config から移し（値は同じ）、日本のタブの 2 列の格子の値を足した（spec-v067 §D.6）。menu-config が出し直す。
