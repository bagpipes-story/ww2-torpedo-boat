diff --git a/src/ui/radar-lines.ts b/src/ui/radar-lines.ts
new file mode 100644
index 0000000..e7d919b
--- /dev/null
+++ b/src/ui/radar-lines.ts
@@ -0,0 +1,67 @@
+// レーダーの 2 行目の出来事の文（v0.8.0 S4。spec-v0800 §4.9・§3.2 D-R2・D-R10、brief L26）: 夜の最初の接触・接触が増えた・東の縁で消えた（ビラ）・東の縁に現れた（帰りの列か）。
+// 読むのはレーダーのテレメトリ（t.radar: 丸めた輝点・数・最初／新しい／消えた接触と、掃引の時の自艇の位置）だけ。艦の正体・列の段階・AI・本当の位置は読まない（tests/radar-lines が
+// ソースの走査で読む欄を固定）。方位と距離は掃引の時の自艇から（atan2 は出来事の 1 回だけ＝§7）。東の縁の帯は config/strait-hud-config（見せ方の値・理由はそこ）。Phaser・DOM を読まない。
+import { RADAR_EAST_EDGE_MARGIN_M, RADAR_LINE_STEP_M } from '../config/strait-hud-config';
+import type { RadarTelemetry } from '../core/boat-telemetry';
+import { bearingJa } from '../core/briefing';
+
+/** 出来事の種類（ui/strait-line-clock の待ちの重さの順: 新しい接触 < 最初の接触 < ビラへ消えた < 帰りの列） */
+export const RADAR_EV_NONE = 0;
+export const RADAR_EV_NEW = 1;
+export const RADAR_EV_FIRST = 2;
+export const RADAR_EV_VILA = 3;
+export const RADAR_EV_RETURN = 4;
+
+/** (fromX, fromY) から (x, y) への 8 方位（北 0・時計回り。x 東・y 南） */
+function dirJa(fromX: number, fromY: number, x: number, y: number): string {
+  return bearingJa((Math.atan2(x - fromX, fromY - y) * 180) / Math.PI);
+}
+
+/** 距離の刻み（四捨五入。spec §4.9 の「北西 2300 m」） */
+function distStepM(fromX: number, fromY: number, x: number, y: number): number {
+  return Math.round(Math.hypot(x - fromX, y - fromY) / RADAR_LINE_STEP_M) * RADAR_LINE_STEP_M;
+}
+
+/** 東の縁の帯の内（東へ抜けて戻る列のある任務だけ＝eastJa があるとき） */
+function nearEastEdge(r: RadarTelemetry, x: number): boolean {
+  return r.eastJa !== '' && x >= r.widthM - RADAR_EAST_EDGE_MARGIN_M;
+}
+
+/** 最後に消えた接触の最後の輝点が東の縁の帯の内（「東（ビラ）へ消えた」） */
+export function radarLostAtEastEdge(r: RadarTelemetry): boolean {
+  return nearEastEdge(r, r.lostX);
+}
+
+/** 最後の新しい接触の輝点が東の縁の帯の内（ビラへ消えた後なら「帰りの列か」） */
+export function radarNewAtEastEdge(r: RadarTelemetry): boolean {
+  return nearEastEdge(r, r.newX);
+}
+
+/** 夜の最初の接触: 「レーダー探知！ 北西 2300 m ・ 接触 1 ・ 目では見えない」（us_04 の最初の掃引は出発点から 2 km 余りの護衛＝目の外。tests/radar-lines が今夜の揺らぎで確かめる） */
+export function radarFirstLineJa(r: RadarTelemetry): string {
+  return `レーダー探知！ ${dirJa(r.firstFromX, r.firstFromY, r.firstX, r.firstY)} ${distStepM(r.firstFromX, r.firstFromY, r.firstX, r.firstY)} m ・ 接触 ${r.contacts} ・ 目では見えない`;
+}
+
+/** 接触が増えた: 「レーダー: 西に新しい接触 3600 m ・ 接触 2」 */
+export function radarNewLineJa(r: RadarTelemetry): string {
+  return `レーダー: ${dirJa(r.fromX, r.fromY, r.newX, r.newY)}に新しい接触 ${distStepM(r.fromX, r.fromY, r.newX, r.newY)} m ・ 接触 ${r.contacts}`;
+}
+
+/** 接触が東の縁で消えた（1 夜に 1 回）: 「接触が東（ビラ）へ消えた ・ 揚陸を終えると同じ海峡を戻ってくる」 */
+export function radarVilaLineJa(r: RadarTelemetry): string {
+  return `接触が東（${r.eastJa}）へ消えた ・ 揚陸を終えると同じ海峡を戻ってくる`;
+}
+
+/** ビラへ消えた後に東の縁に現れた接触（1 夜に 1 回）: 「レーダー: 東に新しい接触 2300 m ・ 帰りの列か ・ 進路から離れよ」 */
+export function radarReturnLineJa(r: RadarTelemetry): string {
+  return `レーダー: 東に新しい接触 ${distStepM(r.fromX, r.fromY, r.newX, r.newY)} m ・ 帰りの列か ・ 進路から離れよ`;
+}
+
+/** 出来事の種類の文（RADAR_EV_*。今のテレメトリの最後の出来事から。種類の無いものは ''） */
+export function radarEventLineJa(kind: number, r: RadarTelemetry): string {
+  if (kind === RADAR_EV_FIRST) return radarFirstLineJa(r);
+  if (kind === RADAR_EV_NEW) return radarNewLineJa(r);
+  if (kind === RADAR_EV_VILA) return radarVilaLineJa(r);
+  if (kind === RADAR_EV_RETURN) return radarReturnLineJa(r);
+  return '';
+}
diff --git a/src/ui/radar-marker-pick.ts b/src/ui/radar-marker-pick.ts
new file mode 100644
index 0000000..22de1fe
--- /dev/null
+++ b/src/ui/radar-marker-pick.ts
@@ -0,0 +1,64 @@
+// 緑の端の印「レーダー N m」の輝点の選び方と置き方の手直し（v0.8.0 S4。spec-v0800 §4.9・D-R10、brief L27）。純粋な関数（Phaser・DOM を読まない＝tests/radar-marker が読む）。
+// 選ぶのは画面の外で、目の届く距離より遠い（d² > 視程²）一番近い輝点だけ（目の内の輝点は赤い「敵 N m」の役＝印を 2 つ出さない。目の絞りはここ＝UI の層。レーダーのテレメトリに視程は無い）。
+// 赤い印の艦（目で見えている最寄りの艦＝t.enemySighted の t.enemyDx・Dy）の今の位置の近く（sameM の内）の輝点も除く（掃引の時の古い輝点がまだ目の外に残る同じ艦）。
+// 画面の内かは ui/edge-marker と同じ写し（カメラの中心は自艇から進行方向に見越しの m 先・ズーム）と ui/edge-marker-screen の markerOnScreen。§7: 確保しない（out に書く）。
+import type { RadarTelemetry } from '../core/boat-telemetry';
+import { degToRad } from '../core/units';
+import { markerOnScreen } from './edge-marker-screen';
+import { EDGE_EPS_PX, type MarkerRect, type MarkerShift } from './marker-separation';
+
+/** 画面の写し（ui/edge-marker の refresh と同じ値: 論理画面の中心・上の余白・左右と下の余白・カメラの見越し m） */
+export interface RadarPickScreen {
+  readonly cx: number;
+  readonly cy: number;
+  readonly topMargin: number;
+  readonly sideMargin: number;
+  readonly lookAheadM: number;
+}
+
+/** 選んだ輝点の自艇からの位置 m と距離の 2 乗（無ければ dx は NaN） */
+export interface RadarPick {
+  dx: number;
+  dy: number;
+  d2: number;
+}
+
+/**
+ * 今の輝点（0〜contacts − 1）のうち、画面の外で目の届く距離より遠く、目で見えている最寄りの艦（seenDx・seenDy。見えていなければ NaN）から sameM より離れた、
+ * 今の自艇から一番近いもの（距離の 2 乗で比べる）を out に書いて返す。eyeRange2 は自艇の視程の 2 乗（t.strait.eyeRange2）、headingDeg・zoom は自艇の針路とカメラのズーム
+ */
+export function pickRadarEdgeBlip(
+  r: RadarTelemetry, eyeRange2: number, seenDx: number, seenDy: number, sameM: number, headingDeg: number, zoom: number, v: RadarPickScreen, out: RadarPick,
+): RadarPick {
+  out.dx = NaN;
+  out.dy = NaN;
+  out.d2 = Infinity;
+  if (!r.enabled) return out;
+  const h = degToRad(headingDeg);
+  const ox = Math.sin(h) * v.lookAheadM;
+  const oy = Math.cos(h) * v.lookAheadM;
+  const same2 = sameM * sameM;
+  for (let k = 0; k < r.contacts && k < r.blips.length; k++) {
+    const b = r.blips[k]!;
+    const dx = b.x - r.boatX;
+    const dy = b.y - r.boatY;
+    const d2 = dx * dx + dy * dy;
+    if (!(d2 > eyeRange2) || !(d2 < out.d2)) continue;
+    if ((dx - seenDx) * (dx - seenDx) + (dy - seenDy) * (dy - seenDy) <= same2) continue; // 赤い印の艦の古い輝点（見えていなければ NaN で比べは偽）
+    if (markerOnScreen((dx - ox) * zoom, (dy + oy) * zoom, v.cx, v.cy, v.topMargin, v.sideMargin)) continue;
+    out.dx = dx;
+    out.dy = dy;
+    out.d2 = d2;
+  }
+  return out;
+}
+
+/**
+ * 右の縁に止まった印のずれ（brief L27: ラベル「レーダー 4000 m」は今の印の半幅より広いので、右の縁なら extraPx だけ左へ＝ラベルが右下の兵装のパネルに届かない）。
+ * 縁でなければ 0。out に書いて返す（dy はいつも 0）
+ */
+export function radarRightEdgeShift(x: number, r: MarkerRect, extraPx: number, out: MarkerShift): MarkerShift {
+  out.dx = Math.abs(x - r.right) < EDGE_EPS_PX ? -extraPx : 0;
+  out.dy = 0;
+  return out;
+}
diff --git a/src/ui/radar-marker.ts b/src/ui/radar-marker.ts
new file mode 100644
index 0000000..598380f
--- /dev/null
+++ b/src/ui/radar-marker.ts
@@ -0,0 +1,56 @@
+// 緑の端の印「レーダー N m」（v0.8.0 S4。spec-v0800 §4.9・§3.2 D-R10・§4.10、brief L27）: 画面の外で目の届く距離より遠い一番近い輝点（ui/radar-marker-pick）へ、画面の縁から緑の矢印。
+// ラベルは矢印の下・100 m 刻みの切り上げ（ui/edge-marker が刻みの変わった時だけ setText）。帰投・敵・敵機の印と縁で近ければ縁に沿って離し（ui/marker-separation）、
+// 右下の速力と兵装の角を避け（avoidCorner）、右の縁ではラベルの広い分だけ左へ寄せる（右端の技能の列は今の印と同じ右の余白 W − 352 で避ける）。
+// レーダーのある任務（t.radar.enabled）だけ ui/hud-markers が作る（ほかの任務は作らない＝絵の数も作る順も今のまま）。§7: 確保は constructor だけ（毎フレームは out に書くだけ）。
+import type Phaser from 'phaser';
+import { GAME_HEIGHT, GAME_WIDTH } from '../config/game-config';
+import { RADAR_MARKER_TEX_KEY } from '../config/radar-art-config';
+import {
+  RADAR_MARKER_LABEL_INSET_PX, RADAR_MARKER_LABEL_JA, RADAR_MARKER_RIGHT_EXTRA_PX, RADAR_MARKER_SAME_SHIP_M, RADAR_MARKER_SEP_PX, RADAR_MARKER_STEP_M, RADAR_MARKER_TEXT_COLOR,
+} from '../config/strait-hud-config';
+import { CAMERA_LOOK_AHEAD_M, TARGET_MARKER_MARGIN, TARGET_MARKER_RIGHT_MARGIN, TARGET_MARKER_TOP_MARGIN } from '../config/ui-config';
+import type { BoatTelemetry } from '../core/boat-telemetry';
+import { EdgeMarker } from './edge-marker';
+import { avoidCorner, separateMarker, type MarkerRect, type MarkerShift } from './marker-separation';
+import { pickRadarEdgeBlip, radarRightEdgeShift, type RadarPick, type RadarPickScreen } from './radar-marker-pick';
+
+/** 緑の印が止まる縁の矩形（赤い「敵」の印と同じ上の余白・ラベルは矢印の下） */
+const RADAR_MARKER_RECT: MarkerRect = { left: TARGET_MARKER_MARGIN, top: TARGET_MARKER_TOP_MARGIN, right: GAME_WIDTH - TARGET_MARKER_RIGHT_MARGIN, bottom: GAME_HEIGHT - TARGET_MARKER_MARGIN };
+const SCREEN: RadarPickScreen = { cx: GAME_WIDTH / 2, cy: GAME_HEIGHT / 2, topMargin: TARGET_MARKER_TOP_MARGIN, sideMargin: TARGET_MARKER_MARGIN, lookAheadM: CAMERA_LOOK_AHEAD_M };
+
+export class RadarEdgeMarker {
+  private readonly m: EdgeMarker;
+  private readonly pick: RadarPick = { dx: NaN, dy: NaN, d2: Infinity };
+  private readonly shift: MarkerShift = { dx: 0, dy: 0 };
+
+  constructor(scene: Phaser.Scene) {
+    this.m = new EdgeMarker(scene, {
+      textureKey: RADAR_MARKER_TEX_KEY, labelPrefix: RADAR_MARKER_LABEL_JA, stepM: RADAR_MARKER_STEP_M, labelAbove: false, roundUp: true,
+      topMargin: TARGET_MARKER_TOP_MARGIN, color: RADAR_MARKER_TEXT_COLOR, labelInset: RADAR_MARKER_LABEL_INSET_PX,
+    });
+  }
+
+  /**
+   * 毎フレーム（ほかの印の refresh の後）: 輝点を選び、縁に置き、出ている印（others。作る時に 1 回組んだ配列）から離し、角を避け、右の縁なら左へ寄せる。keepLeft・keepTop は右下の速力の HUD の塊の左上（ui/hud-markers）。
+   * 距離の平方根は印を出す時だけ 1 本
+   */
+  refresh(t: BoatTelemetry, others: readonly (EdgeMarker | undefined)[], keepLeft: number, keepTop: number): void {
+    const seen = t.enemySighted; // 赤い「敵 N m」の艦（目で見えている最寄りの艦）の古い輝点は緑にしない
+    const p = pickRadarEdgeBlip(t.radar, t.strait.eyeRange2, seen ? t.enemyDx : NaN, seen ? t.enemyDy : NaN, RADAR_MARKER_SAME_SHIP_M, t.headingDeg, t.cameraZoom, SCREEN, this.pick);
+    const show = !Number.isNaN(p.dx);
+    const m = this.m;
+    m.refresh(p.dx, p.dy, show, t, show ? Math.sqrt(p.d2) : undefined);
+    if (!m.isShown) return;
+    const sh = this.shift;
+    for (let i = 0; i < others.length; i++) {
+      const o = others[i];
+      if (o && o.isShown) m.nudge(separateMarker(o.shownX, o.shownY, m.shownX, m.shownY, RADAR_MARKER_RECT, RADAR_MARKER_SEP_PX, sh).dx, sh.dy);
+    }
+    m.nudge(avoidCorner(m.shownX, m.shownY, RADAR_MARKER_RECT, keepLeft - RADAR_MARKER_RIGHT_EXTRA_PX, keepTop, sh).dx, sh.dy); // 下の縁でもラベルの広い分だけ左で止める
+    m.nudge(radarRightEdgeShift(m.shownX, RADAR_MARKER_RECT, RADAR_MARKER_RIGHT_EXTRA_PX, sh).dx, 0);
+  }
+
+  destroy(): void {
+    this.m.destroy();
+  }
+}
diff --git a/src/ui/radar-result.ts b/src/ui/radar-result.ts
new file mode 100644
index 0000000..051bd5c
--- /dev/null
+++ b/src/ui/radar-result.ts
@@ -0,0 +1,33 @@
+// Result のレーダーの 1 行（v0.8.0 S4。spec-v0800 §4.9・§3.2 D-R9、brief L31）: 「レーダー: 最初の接触 北西 2300 m（出撃直後） ・ 目で見えない間に撃った魚雷 2 本（命中 0）」。
+// 材料（RadarResult）は systems/strait-result-part がレーダーの記録（最初の接触の掃引の秒・輝点・その時の自艇）と、発射の時に 3 行目が敵影なしだった魚雷の数え（systems/world-radar）から
+// 終わりに 1 回作る（艦の正体・列の段階・AI・本当の位置は入れない＝brief L26）。レーダーのある任務（us_04）だけ鍵がある。Phaser・DOM を読まない（tests/radar-result が読む）。
+import { RADAR_LINE_STEP_M } from '../config/strait-hud-config';
+import { bearingJa } from '../core/briefing';
+
+/** 最初の接触が出撃からこの秒の前なら「出撃直後」（最初の掃引は出撃の最初の固定ステップ＝約 0.02 秒。brief L31） */
+export const RADAR_RESULT_SOON_S = 1;
+
+/** Result のレーダーの材料（終わりに 1 回） */
+export interface RadarResult {
+  /** 夜の最初の接触の秒（NaN は接触なし）と、その時の自艇から一番近い輝点への位置 m */
+  firstS: number;
+  firstDx: number;
+  firstDy: number;
+  /** 狙える艦がある間に撃った魚雷のうち、発射の時に 3 行目が敵影なしだった本数と、そのうちの命中（不発を除く） */
+  unseenShots: number;
+  unseenHits: number;
+}
+
+/** 最初の接触の句（「最初の接触 北西 2300 m（出撃直後）」か「接触なし」） */
+export function radarFirstContactJa(r: RadarResult): string {
+  if (Number.isNaN(r.firstS)) return '接触なし';
+  const dir = bearingJa((Math.atan2(r.firstDx, -r.firstDy) * 180) / Math.PI);
+  const dist = Math.round(Math.hypot(r.firstDx, r.firstDy) / RADAR_LINE_STEP_M) * RADAR_LINE_STEP_M;
+  return `最初の接触 ${dir} ${dist} m（${r.firstS < RADAR_RESULT_SOON_S ? '出撃直後' : `出撃 ${Math.round(r.firstS)} 秒`}）`;
+}
+
+/** Result のレーダーの 1 行 */
+export function radarResultLineJa(r: RadarResult): string {
+  const shots = r.unseenShots > 0 ? `${r.unseenShots} 本（命中 ${r.unseenHits}）` : '0 本';
+  return `レーダー: ${radarFirstContactJa(r)} ・ 目で見えない間に撃った魚雷 ${shots}`;
+}
