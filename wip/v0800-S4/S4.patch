+describe('列が去った後の 3 行目（brief L30: S2 の夜明けの形のまま）', () => {
+  it('「東京急行は西へ去った ・ 狙う艦なし」は戻りの残りがある間は出ない: 護衛を沈め列がビラにいる間も allOut は偽。最後の列の艦が去ったステップから真', () => {
+    for (const hard of [false, true]) {
