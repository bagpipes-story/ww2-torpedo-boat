--- /dev/null
+++ b/src/systems/radar-telemetry.ts
@@ -0,0 +1,55 @@
+// レーダーのテレメトリ（v0.8.0 S2。spec-v0800 §4.9 の材料・§6 の S2）: createTelemetry で 1 回作り（initRadarTelemetry）、毎フレーム refreshTelemetry の中で 1 回だけ中身を写す
+// （§7: 確保しない）。core/radar の状態の数と出来事（数えて残す＝1 フレームに掃引が何回あっても読み落とさない）をそのまま写すだけ。読むのは世界の radar だけ、書くのは t.radar だけ
+// （brief L9。tests/radar-neutral が走査）。レーダーの無い任務・?debug&noradar は enabled false のまま何もしない。HUD の 2 行目の文・端の印・Result の行は S4。
+import type { RadarTelemetry } from '../core/boat-telemetry';
+import type { RadarState } from '../core/radar';
+
+/** 読む世界の部分（MissionWorld がそのまま満たす） */
+export interface RadarTelemetryWorld {
+  readonly radar: { readonly state: RadarState; readonly p: { readonly shipRangeM: number } } | null;
+}
+
+/** 出発時の radar（任務で決まる射程と、まだ掃引していない数） */
+export function initRadarTelemetry(w: RadarTelemetryWorld): RadarTelemetry {
+  const t: RadarTelemetry = {
+    enabled: w.radar !== null,
+    shipRangeM: w.radar ? w.radar.p.shipRangeM : 0,
+    sweeps: 0,
+    contacts: 0,
+    nearestM: NaN,
+    firstS: NaN,
+    firstX: NaN,
+    firstY: NaN,
+    firstFromX: NaN,
+    firstFromY: NaN,
+    newCount: 0,
+    newX: NaN,
+    newY: NaN,
+    lostCount: 0,
+    lostX: NaN,
+    lostY: NaN,
+  };
+  refreshRadarTelemetry(t, w);
+  return t;
+}
+
+/** 毎フレーム 1 回（レーダーの無い任務は何もしない） */
+export function refreshRadarTelemetry(t: RadarTelemetry, w: RadarTelemetryWorld): void {
+  const r = w.radar;
+  if (!r) return;
+  const s = r.state;
+  t.sweeps = s.sweeps;
+  t.contacts = s.n;
+  t.nearestM = s.nearestM;
+  t.firstS = s.firstS;
+  t.firstX = s.firstX;
+  t.firstY = s.firstY;
+  t.firstFromX = s.firstFromX;
+  t.firstFromY = s.firstFromY;
+  t.newCount = s.newCount;
+  t.newX = s.newX;
+  t.newY = s.newY;
+  t.lostCount = s.lostCount;
+  t.lostX = s.lostX;
+  t.lostY = s.lostY;
+}
diff --git a/src/systems/radar-view.ts b/src/systems/radar-view.ts
new file mode 100644
index 0000000..4fc3d17
--- /dev/null
+++ b/src/systems/radar-view.ts
@@ -0,0 +1,60 @@
+// レーダーの輝点の絵（v0.8.0 S2。spec-v0800 §3.2 の D-R2・§5.2・§7 の 1〜3、brief L15）: 起動時に緑の輪の Image を 16 個（core/radar の RADAR_BLIP_CAPACITY）作っておき、
+// 掃引の回数が変わった時だけ位置と見せる・隠すを書く（掃引の間は動かない）。薄れ方は輝点を置いた掃引の秒からの経過（固定ステップの時計）を 10 段に丸め、
+// 段が変わった時だけ setAlpha（tween なし）。輪の絵は assets/radar-art が初めて使う時に 1 回作る。論理の状態は読むだけ。§7: 確保は constructor だけ。
+// buildRadar（mission-world が 1 回呼ぶ）: setup.radar の任務（us_04）だけ WorldRadar とこの絵を作る。無い任務・?debug&noradar は null（絵も絵の鍵も作らない）。
+import type Phaser from 'phaser';
+import { ensureRadarBlipTexture } from '../assets/radar-art';
+import { RENDER_SCALE } from '../config/game-config';
+import { RADAR_BLIP_DEPTH, RADAR_BLIP_FADE_STEPS, RADAR_BLIP_TEX_KEY, radarBlipAlpha } from '../config/radar-art-config';
+import { RADAR_BLIP_CAPACITY, radarAge01, type RadarState } from '../core/radar';
+import { WorldRadar, type RadarBlipView } from './world-radar';
+import type { WorldSetup } from './world-setup';
+
+export type { WorldRadar } from './world-radar';
+
+export class RadarView implements RadarBlipView {
+  private readonly imgs: Phaser.GameObjects.Image[] = [];
+  /** 位置を書いた掃引の回数（−1 は未だ）と、輝点ごとの今の薄れの段（−1 は未だ） */
+  private placedSweeps = -1;
+  private readonly fade = new Int8Array(RADAR_BLIP_CAPACITY).fill(-1);
+
+  constructor(scene: Phaser.Scene) {
+    ensureRadarBlipTexture(scene);
+    for (let k = 0; k < RADAR_BLIP_CAPACITY; k++) this.imgs.push(scene.add.image(0, 0, RADAR_BLIP_TEX_KEY).setScale(1 / RENDER_SCALE).setDepth(RADAR_BLIP_DEPTH).setVisible(false));
+  }
+
+  /** 毎フレーム: 掃引が変わった時だけ置き直し、薄れの段が変わった輝点だけ α を書く */
+  update(s: RadarState, nowS: number, sweepS: number): void {
+    if (s.sweeps !== this.placedSweeps) {
+      this.placedSweeps = s.sweeps;
+      for (let k = 0; k < RADAR_BLIP_CAPACITY; k++) {
+        const img = this.imgs[k]!;
+        this.fade[k] = -1;
+        if (k < s.n) {
+          const b = s.blips[k]!;
+          img.setPosition(b.x, b.y);
+          if (!img.visible) img.setVisible(true);
+        } else if (img.visible) {
+          img.setVisible(false);
+        }
+      }
+    }
+    for (let k = 0; k < s.n; k++) {
+      const q = Math.round(radarAge01(s.blips[k]!.atS, nowS, sweepS) * RADAR_BLIP_FADE_STEPS);
+      if (q === this.fade[k]) continue;
+      this.fade[k] = q;
+      this.imgs[k]!.setAlpha(radarBlipAlpha(q));
+    }
+  }
+
+  destroy(): void {
+    for (const img of this.imgs) img.destroy();
+    this.imgs.length = 0;
+  }
+}
+
+/** レーダーの世界と絵（setup.radar の任務だけ。無ければ null）。世界の論理の全部の後・世界の絵の前に 1 回 */
+export function buildRadar(scene: Phaser.Scene, w: { readonly setup: WorldSetup; readonly destroyers: { readonly total: number } | null }): WorldRadar | null {
+  const p = w.setup.radar;
+  return p ? new WorldRadar(p, w.setup.mission.bounds, w.setup.shores, w.destroyers ? w.destroyers.total : 0, new RadarView(scene)) : null;
+}
diff --git a/src/systems/strait-terrain.ts b/src/systems/strait-terrain.ts
new file mode 100644
index 0000000..4a2d33b
--- /dev/null
+++ b/src/systems/strait-terrain.ts
@@ -0,0 +1,73 @@
+// 海峡の両岸の陸と字（v0.8.0 S2。us_04「ブラケット海峡の夜」。spec-v0800 §4.3・§4.10・§5.2、brief L15）: 北の縁 y 0 の外（コロンバンガラ島）と南の縁の外
+// （アランデル島・ギゾ島。ファーガソン水道の切れ目は陸を描かず海が南へ続く）の陸の塗りと浜の線、島・水道・揚陸の地（「ビラ →」）の名。
+// systems/evac-terrain の作法: 起動時に 1 回だけ Graphics に記録し、毎フレーム触らない（世界の大きさのテクスチャにしない）。陸の際の砂浜・寄せ波・樹冠は今の岸の帯
+// （tex-coast-strip を 1 回だけ作って systems/coast-fx が陸の区間ごとに並べる）。描く命令は 塗りの色 1・陸の矩形（区間の数＝us_04 は 3）・線の色 1・浜の線（区間の数）・
+// 水道に面した陸の端の線（切れ目の両端＝us_04 は 2）＝us_04 で 10。字は島の名（labels）・切れ目の名・揚陸の地の名の Text（us_04 は 5）。論理の状態は読むだけ。
+import type Phaser from 'phaser';
+import { shoreLandSpans } from '../assets/coast-shape';
+import { DEPTH } from '../config/game-config';
+import { COAST_LABEL_FONT_PX, COAST_LAND_COLOR, COAST_LINE_COLOR, COAST_LINE_WIDTH, COAST_TEXT_COLOR } from '../config/hunt-config';
+import type { ShoreSide, ShoresSetup } from '../config/shores-mission-data';
+import { STRAIT_LANDING_ARROW_EAST_JA, STRAIT_LANDING_ARROW_WEST_JA } from '../config/strait-art-config';
+import type { TransitSetup } from '../config/transit-mission-data';
+import { hudTextStyle } from '../config/ui-config';
+
+/** 世界から読む物（WorldSetup の一部） */
+export interface StraitSetupView {
+  readonly mission: { readonly bounds: { readonly width: number; readonly height: number } };
+  readonly shores?: ShoresSetup;
+  readonly transit?: TransitSetup;
+}
+
+export class StraitTerrain {
+  private readonly graphics: Phaser.GameObjects.Graphics;
+  private readonly labels: Phaser.GameObjects.Text[] = [];
+
+  constructor(scene: Phaser.Scene, s: StraitSetupView) {
+    const g = scene.add.graphics().setDepth(DEPTH.shallows);
+    this.graphics = g;
+    const sh = s.shores;
+    if (!sh) return;
+    const { width, height } = s.mission.bounds;
+    g.fillStyle(COAST_LAND_COLOR, 1);
+    for (const sp of shoreLandSpans(sh.north, width)) g.fillRect(sp.x0, -sh.north.landM, sp.x1 - sp.x0, sh.north.landM);
+    for (const sp of shoreLandSpans(sh.south, width)) g.fillRect(sp.x0, height, sp.x1 - sp.x0, sh.south.landM);
+    g.lineStyle(COAST_LINE_WIDTH, COAST_LINE_COLOR, 1);
+    this.shoreLines(g, sh.north, width, 0, -1);
+    this.shoreLines(g, sh.south, width, height, 1);
+    this.side(scene, sh.north, -sh.north.landM / 2);
+    this.side(scene, sh.south, height + sh.south.landM / 2);
+    // 揚陸の地（列が抜ける縁の外。北の陸の上）の名と矢印
+    const tr = s.transit;
+    if (tr) {
+      const east = tr.inbound.edge === 'west';
+      const text = east ? `${tr.vilaLabelJa} ${STRAIT_LANDING_ARROW_EAST_JA}` : `${STRAIT_LANDING_ARROW_WEST_JA} ${tr.vilaLabelJa}`;
+      this.label(scene, east ? width + sh.north.landM / 2 : -sh.north.landM / 2, -sh.north.landM / 2, text);
+    }
+  }
+
+  /** 浜の線（陸の区間ごと）と、切れ目（水道）に面した陸の端の線（岸の線 y から陸の側 sign へ陸の幅） */
+  private shoreLines(g: Phaser.GameObjects.Graphics, side: ShoreSide, width: number, y: number, sign: number): void {
+    for (const sp of shoreLandSpans(side, width)) g.lineBetween(sp.x0, y, sp.x1, y);
+    for (const gap of side.gaps) {
+      g.lineBetween(gap.x0, y, gap.x0, y + sign * side.landM);
+      g.lineBetween(gap.x1, y, gap.x1, y + sign * side.landM);
+    }
+  }
+
+  /** 1 辺の字: 島の名（陸の中ほど）と切れ目の名（切れ目の真ん中・陸と同じ深さの海の上） */
+  private side(scene: Phaser.Scene, side: ShoreSide, y: number): void {
+    for (const l of side.labels) this.label(scene, l.x, y, l.labelJa);
+    for (const gap of side.gaps) this.label(scene, (gap.x0 + gap.x1) / 2, y, side.gapLabelJa);
+  }
+
+  private label(scene: Phaser.Scene, x: number, y: number, text: string): void {
+    this.labels.push(scene.add.text(x, y, text, hudTextStyle(COAST_LABEL_FONT_PX, COAST_TEXT_COLOR)).setOrigin(0.5).setDepth(DEPTH.shallows));
+  }
+
+  destroy(): void {
+    this.graphics.destroy();
+    for (const l of this.labels) l.destroy();
+    this.labels.length = 0;
+  }
+}
