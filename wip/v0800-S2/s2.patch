+      expect(a.x).toBeGreaterThanOrEqual(tr.inbound.goneX);
+      expect(a.x - tr.inbound.goneX).toBeLessThan(tr.speedMps * w.setup.timeScale / 60 + 1e-6);
+      expect(o.t - a.t).toBeGreaterThanOrEqual(tr.unloadS - 1e-6);
