+  let bad = 0;
+  for (const r of res) {
+    const tag = `${r.hard ? 'hard  ' : 'normal'} seed ${String(r.seed).padStart(2)} ${r.policy.padEnd(9)}`;
+    if (r.error) { bad++; console.log(`${tag} ERROR ${r.error}${r.errors.length ? ` | page errors ${r.errors.length}: ${r.errors[0]}` : ''}`); continue; }
+    if (r.smoke) {
