+      if (!ok) bad++;
+      console.log(`${tag} smoke frames ${r.frames} t ${r.t.toFixed(1)} Mission ${r.mission} Result ${r.result} 残存 ${r.survivors} 決着 ${r.settled} 来た ${r.came} 着弾 ${r.impacts} 物 ${r.children}${r.errors.length ? ` | page errors ${r.errors.length}: ${r.errors[0]}` : ''}`);
