+        if (k === 0 || k === 900) launcher.queueFan(boat, 4, 12);
+        const tgt = ships.find((x) => !x.out) ?? null;
+        const ts = launcher.update(s.stepS, boat, tgt ? tgt.state : null, tgt !== null);
