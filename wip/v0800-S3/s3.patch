+  rammedBy: number;
+  /** 終わりの燃料（割当の %）・HP・被弾 */
+  fuelPct: number;
+  hpLeft: number;
+  shellHits: number;
+  /** 撃った本数（狙う艦の無い魚雷を除く）・不発でない命中・正しく狙った 1 本（|見越しのずれ| ≤ aimed・蛇行なし・KPI の的・B6 の距離の内）とその命中 */
