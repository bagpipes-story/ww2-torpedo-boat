+// 迎撃の模擬（v0.8.0 S3。us_04「ブラケット海峡の夜」。spec-v0800 §4.11、lead の L23）の帯を軽い組で見る: N 50 × 2 組（seed 1〜50・1001〜1050）の
+// 帯の行のある 5 つの遊び方（ノーマル。radar_twice・home_after_inbound は表だけの行）と radar_ambush（ハード）で、systems/intercept-calibration の帯
+// （B1〜B6・燃料 F・ハードの H1・H2）が ✗ 0。
+// 軽い組の選び方: 表（scripts/intercept-sim の TABLE=2＝N 400 × 2 組）の 800 夜を 50 × 2 の 8 つの組（seed 1+50k〜50+50k・1001+50k〜1050+50k、k = 0〜7）に割り、
+// 帯ごとの ✓/✗ を 800 夜の表と比べた（CHANGELOG v0.8.0 S3）。ここは k = 0 の組＝全部の帯で 800 夜と同じ ✓/✗。8 組の揺れは帯の端の近くで ±5 点ほど
+// （S3 の表では k = 3 の B1a・H1 が 35.0% で ✓）。帯の端に寄った値は軽い組で裏返りうるので、つまみや帯を動かしたら 8 組をもう一度比べる。B6 は夜に依らない（固定の seed の 1 本の射撃）。
+// 本数（N 400 × 2 組）の帯は scripts/headless/g2.sh の US04=1。
+import { describe, expect, it } from 'vitest';
+import { gameData } from '../src/config/game-data';
+import { runInterceptTrial } from '../src/core/intercept-sim';
+import { interceptCellOf, type InterceptCell } from '../src/core/intercept-sim-cell';
+import type { InterceptPolicy } from '../src/core/intercept-sim-policy';
+import { interceptB6, interceptBandChecks } from '../src/systems/intercept-calibration';
+import { interceptNightSetup } from '../src/systems/intercept-sim-setup';
+
+/** 帯の行のある遊び方（B1・F radar_ambush、B2 eye_only、B3 idle_lane、B4 radar_dodge、B5 charge） */
+const BANDED: readonly InterceptPolicy[] = ['radar_ambush', 'eye_only', 'idle_lane', 'radar_dodge', 'charge'];
+/** 軽い組の seed（50 × 2 組） */
+const LIGHT_SEEDS: readonly number[] = [...Array.from({ length: 50 }, (_, i) => 1 + i), ...Array.from({ length: 50 }, (_, i) => 1001 + i)];
+
+function cells(hard: boolean, pols: readonly InterceptPolicy[]): Map<InterceptPolicy, InterceptCell> {
+  const out = new Map<InterceptPolicy, InterceptCell>();
+  const setups = LIGHT_SEEDS.map((seed) => interceptNightSetup(gameData, seed, hard));
+  const objective = setups[0]!.objectiveSinks;
+  for (const p of pols) out.set(p, interceptCellOf(setups.map((s, i) => runInterceptTrial(s, p, LIGHT_SEEDS[i]!)), objective));
+  return out;
+}
+
+const failed = (checks: readonly { id: string; text: string; ok: boolean }[]): string[] => checks.filter((x) => !x.ok).map((x) => `${x.id} ${x.text}`);
+
+describe('迎撃の模擬の帯（軽い組 N 50 × 2）', () => {
